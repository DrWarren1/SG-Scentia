<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SCENTIA — Smell Good Scentia</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

<style>

/* ── Reset & tokens ─────────────────────────────────────────────────── */
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

:root {
  --cream:   #fbf8f3;
  --sand:    #f0e8d8;
  --gold:    #c9a84c;
  --gold-lt: #e2c97e;
  --dark:    #111010;
  --dark2:   #1e1c1a;
  --muted:   #888078;
  --text:    #2a2520;
  --radius:  28px;
  --serif:   'Cormorant Garamond', Georgia, serif;
  --sans:    'Inter', Arial, sans-serif;
}

html { scroll-behavior: smooth; }

body {
  background: var(--cream);
  color: var(--text);
  font-family: var(--sans);
  overflow-x: hidden;
}

/* ── Scrollbar ──────────────────────────────────────────────────────── */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: var(--cream); }
::-webkit-scrollbar-thumb { background: var(--gold); border-radius: 3px; }

/* ── Nav ────────────────────────────────────────────────────────────── */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22px 48px;
  transition: background .4s, backdrop-filter .4s, padding .4s;
}

nav.scrolled {
  background: rgba(251,248,243,.85);
  backdrop-filter: blur(16px);
  padding: 14px 48px;
  border-bottom: 1px solid rgba(201,168,76,.15);
}

.nav-logo {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
}

.nav-logo-mark {
  width: 38px; height: 38px;
  border-radius: 50%;
  background: var(--dark);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}

.nav-logo-mark svg { width: 18px; height: 18px; }

.nav-logo-text {
  font-family: var(--serif);
  font-size: 1.25rem;
  font-weight: 500;
  letter-spacing: .12em;
  color: var(--text);
}

.nav-links {
  display: flex;
  gap: 36px;
  list-style: none;
}

.nav-links a {
  text-decoration: none;
  font-size: .78rem;
  font-weight: 400;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--text);
  opacity: .7;
  transition: opacity .25s;
}

.nav-links a:hover { opacity: 1; }

.nav-cta {
  background: var(--dark);
  color: var(--cream) !important;
  opacity: 1 !important;
  padding: 10px 24px;
  border-radius: 50px;
  transition: background .25s, transform .25s !important;
}

.nav-cta:hover {
  background: var(--dark2) !important;
  transform: translateY(-1px);
}

/* ── Hero ───────────────────────────────────────────────────────────── */
.hero {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  padding: 120px 48px 80px;
  gap: 48px;
  max-width: 1280px;
  margin: 0 auto;
}

.hero-copy { max-width: 520px; }

.eyebrow {
  font-size: .7rem;
  font-weight: 500;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.eyebrow::before {
  content: '';
  width: 32px; height: 1px;
  background: var(--gold);
}

.hero h1 {
  font-family: var(--serif);
  font-size: clamp(3rem, 5vw, 4.8rem);
  font-weight: 300;
  line-height: 1.08;
  letter-spacing: -.01em;
  color: var(--text);
  margin-bottom: 28px;
}

.hero h1 em {
  font-style: italic;
  color: var(--muted);
}

.hero-desc {
  font-size: .95rem;
  line-height: 1.75;
  color: var(--muted);
  margin-bottom: 44px;
  max-width: 420px;
}

.btn-group { display: flex; gap: 16px; flex-wrap: wrap; }

.btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 32px;
  border-radius: 50px;
  font-size: .82rem;
  font-weight: 500;
  letter-spacing: .08em;
  text-transform: uppercase;
  text-decoration: none;
  cursor: pointer;
  border: none;
  transition: transform .25s, box-shadow .25s;
}

.btn:hover { transform: translateY(-2px); }

.btn-dark {
  background: var(--dark);
  color: var(--cream);
  box-shadow: 0 8px 32px rgba(17,16,16,.22);
}

.btn-dark:hover { box-shadow: 0 12px 40px rgba(17,16,16,.32); }

.btn-outline {
  background: transparent;
  color: var(--text);
  border: 1px solid rgba(42,37,32,.25);
}

.btn-outline:hover { border-color: var(--text); }

.hero-stat-row {
  margin-top: 56px;
  display: flex;
  gap: 40px;
}

.hero-stat span {
  display: block;
  font-family: var(--serif);
  font-size: 2.2rem;
  font-weight: 300;
  color: var(--text);
}

.hero-stat small {
  font-size: .7rem;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--muted);
}

/* Machine visuel */
.hero-visual {
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
}

.glow-ring {
  position: absolute;
  width: 440px; height: 440px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(201,168,76,.18) 0%, transparent 70%);
  animation: pulse 4s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50%       { transform: scale(1.06); opacity: .7; }
}

.machine-wrap {
  position: relative;
  display: flex;
  align-items: flex-end;
}

.machine {
  width: 280px; height: 420px;
  border-radius: 40px 40px 30px 30px;
  background: linear-gradient(165deg, #2e2b28 0%, #181614 60%, #0e0d0c 100%);
  position: relative;
  box-shadow:
    0 40px 80px rgba(17,16,16,.45),
    0 0 0 1px rgba(255,255,255,.06),
    inset 0 1px 0 rgba(255,255,255,.08);
}

.machine-screen {
  position: absolute;
  top: 36px; left: 50%; transform: translateX(-50%);
  width: 160px; height: 90px;
  border-radius: 12px;
  background: linear-gradient(135deg, #1a2535, #0d1320);
  border: 1px solid rgba(201,168,76,.2);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}

.screen-wave {
  width: 120px; height: 40px;
  position: relative;
}

.screen-wave svg { width: 100%; height: 100%; }

.machine-dial {
  position: absolute;
  bottom: 70px; left: 50%; transform: translateX(-50%);
  width: 72px; height: 72px;
  border-radius: 50%;
  background: conic-gradient(var(--gold) 0deg 120deg, #2a2520 120deg 360deg);
  box-shadow: 0 4px 20px rgba(0,0,0,.5), inset 0 0 0 6px #1a1816;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
  transition: transform .6s ease;
}

.machine-dial:hover { transform: translateX(-50%) rotate(30deg); }

.machine-dial::after {
  content: '';
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--gold);
  box-shadow: 0 0 8px var(--gold);
}

.machine-led {
  position: absolute;
  bottom: 38px; left: 50%; transform: translateX(-50%);
  display: flex; gap: 6px;
}

.led-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--gold);
  box-shadow: 0 0 6px var(--gold);
  animation: blink 2.4s ease-in-out infinite;
}

.led-dot:nth-child(2) { animation-delay: .4s; background: #c9e88c; box-shadow: 0 0 6px #c9e88c; }
.led-dot:nth-child(3) { animation-delay: .8s; }

@keyframes blink {
  0%, 100% { opacity: 1; }
  50%       { opacity: .3; }
}

.machine-vent {
  position: absolute;
  top: 155px; left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column; gap: 5px;
}

.vent-line {
  width: 40px; height: 2px;
  border-radius: 1px;
  background: rgba(255,255,255,.08);
}

.machine-tag {
  position: absolute;
  top: -18px; right: -18px;
  background: var(--gold);
  color: var(--dark);
  font-size: .62rem;
  font-weight: 500;
  letter-spacing: .1em;
  text-transform: uppercase;
  padding: 5px 12px;
  border-radius: 50px;
  white-space: nowrap;
}

.mist-wrap {
  position: absolute;
  top: -60px; left: 50%; transform: translateX(-50%);
  display: flex; gap: 14px;
}

.mist-particle {
  width: 10px; height: 10px;
  border-radius: 50%;
  background: rgba(201,168,76,.3);
  filter: blur(4px);
  animation: float 3s ease-in-out infinite;
}

.mist-particle:nth-child(2) { animation-delay: .6s; width: 7px; height: 7px; }
.mist-particle:nth-child(3) { animation-delay: 1.2s; width: 12px; height: 12px; }

@keyframes float {
  0%   { transform: translateY(0) scale(1); opacity: .6; }
  100% { transform: translateY(-50px) scale(.4); opacity: 0; }
}

/* ── Features ───────────────────────────────────────────────────────── */
.features {
  padding: 120px 48px;
  max-width: 1280px;
  margin: 0 auto;
}

.section-header {
  max-width: 560px;
  margin: 0 auto 80px;
  text-align: center;
}

.section-header .eyebrow { justify-content: center; }
.section-header .eyebrow::before { display: none; }

.section-header h2 {
  font-family: var(--serif);
  font-size: clamp(2.2rem, 3.5vw, 3.4rem);
  font-weight: 300;
  line-height: 1.15;
  margin-bottom: 16px;
}

.section-header p {
  font-size: .92rem;
  line-height: 1.75;
  color: var(--muted);
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.feat-card {
  background: white;
  border-radius: var(--radius);
  padding: 44px 36px;
  position: relative;
  overflow: hidden;
  transition: transform .3s, box-shadow .3s;
  box-shadow: 0 2px 20px rgba(0,0,0,.04);
}

.feat-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 20px 50px rgba(0,0,0,.09);
}

.feat-card.accent {
  background: linear-gradient(135deg, var(--dark) 0%, #282420 100%);
  color: var(--cream);
}

.feat-icon {
  width: 52px; height: 52px;
  border-radius: 16px;
  background: var(--sand);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 28px;
  font-size: 1.4rem;
}

.feat-card.accent .feat-icon {
  background: rgba(201,168,76,.15);
}

.feat-card h3 {
  font-family: var(--serif);
  font-size: 1.45rem;
  font-weight: 400;
  margin-bottom: 12px;
  line-height: 1.3;
}

.feat-card p {
  font-size: .87rem;
  line-height: 1.75;
  color: var(--muted);
}

.feat-card.accent p { color: rgba(251,248,243,.55); }

.feat-card-badge {
  position: absolute;
  top: 28px; right: 28px;
  width: 32px; height: 32px;
  border-radius: 50%;
  background: var(--sand);
  display: flex; align-items: center; justify-content: center;
  font-size: .65rem;
  font-weight: 500;
  letter-spacing: .05em;
  color: var(--muted);
}

.feat-card.accent .feat-card-badge {
  background: rgba(255,255,255,.07);
  color: var(--gold-lt);
}

/* ── Products dark ──────────────────────────────────────────────────── */
.products {
  background: var(--dark);
  padding: 120px 48px;
  position: relative;
  overflow: hidden;
}

.products::before {
  content: '';
  position: absolute;
  width: 600px; height: 600px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(201,168,76,.08) 0%, transparent 70%);
  top: -100px; right: -100px;
  pointer-events: none;
}

.products-inner {
  max-width: 1280px;
  margin: 0 auto;
}

.products .section-header { color: var(--cream); }
.products .section-header h2 { color: var(--cream); }
.products .section-header p { color: rgba(251,248,243,.45); }
.products .eyebrow { color: var(--gold-lt); }

.products-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 28px;
}

.prod-card {
  border-radius: var(--radius);
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(255,255,255,.07);
  padding: 48px 44px;
  display: flex;
  align-items: flex-start;
  gap: 32px;
  transition: background .3s, border-color .3s;
  cursor: default;
}

.prod-card:hover {
  background: rgba(255,255,255,.07);
  border-color: rgba(201,168,76,.25);
}

.prod-icon {
  width: 80px; height: 80px;
  border-radius: 22px;
  background: rgba(201,168,76,.1);
  border: 1px solid rgba(201,168,76,.2);
  flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 2rem;
}

.prod-info h3 {
  font-family: var(--serif);
  font-size: 1.55rem;
  font-weight: 400;
  color: var(--cream);
  margin-bottom: 10px;
  line-height: 1.25;
}

.prod-info p {
  font-size: .87rem;
  line-height: 1.75;
  color: rgba(251,248,243,.45);
  margin-bottom: 20px;
}

.prod-tags { display: flex; flex-wrap: wrap; gap: 8px; }

.tag {
  font-size: .65rem;
  font-weight: 500;
  letter-spacing: .1em;
  text-transform: uppercase;
  padding: 5px 12px;
  border-radius: 50px;
  background: rgba(201,168,76,.1);
  color: var(--gold-lt);
  border: 1px solid rgba(201,168,76,.18);
}

/* ── Scents ─────────────────────────────────────────────────────────── */
.scents {
  padding: 120px 48px;
  max-width: 1280px;
  margin: 0 auto;
}

.scents-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.scent-card {
  border-radius: 22px;
  padding: 36px 28px;
  position: relative;
  overflow: hidden;
  transition: transform .3s;
  cursor: pointer;
  min-height: 220px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.scent-card:hover { transform: translateY(-5px); }

.scent-card::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 22px;
  opacity: .08;
  background: var(--bg);
}

.scent-1 { background: linear-gradient(145deg, #f5e6d0, #e8c9a0); }
.scent-2 { background: linear-gradient(145deg, #dce8e0, #b8d4c0); }
.scent-3 { background: linear-gradient(145deg, #e0d4e8, #c4b0d4); }
.scent-4 { background: linear-gradient(145deg, #e8e0d0, #d0c4a8); }

.scent-emoji { font-size: 2.8rem; margin-bottom: 16px; display: block; }

.scent-card h4 {
  font-family: var(--serif);
  font-size: 1.25rem;
  font-weight: 400;
  color: var(--dark);
  margin-bottom: 4px;
}

.scent-card small {
  font-size: .73rem;
  color: rgba(42,37,32,.6);
  letter-spacing: .06em;
}

/* ── Testimonials ───────────────────────────────────────────────────── */
.testimonials {
  background: var(--sand);
  padding: 120px 48px;
}

.testimonials-inner {
  max-width: 1280px;
  margin: 0 auto;
}

.testi-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  margin-top: 64px;
}

.testi-card {
  background: white;
  border-radius: var(--radius);
  padding: 40px 36px;
  transition: transform .3s;
}

.testi-card:hover { transform: translateY(-4px); }

.stars {
  display: flex;
  gap: 3px;
  margin-bottom: 20px;
}

.star { color: var(--gold); font-size: 1rem; }

.testi-text {
  font-family: var(--serif);
  font-size: 1.1rem;
  font-style: italic;
  line-height: 1.65;
  color: var(--text);
  margin-bottom: 28px;
}

.testi-author {
  display: flex;
  align-items: center;
  gap: 14px;
}

.author-avatar {
  width: 44px; height: 44px;
  border-radius: 50%;
  background: var(--sand);
  display: flex; align-items: center; justify-content: center;
  font-size: 1.1rem;
  flex-shrink: 0;
}

.author-name {
  font-size: .88rem;
  font-weight: 500;
  color: var(--text);
}

.author-role {
  font-size: .75rem;
  color: var(--muted);
  margin-top: 1px;
}

/* ── CTA Banner ─────────────────────────────────────────────────────── */
.cta-banner {
  background: var(--dark);
  padding: 100px 48px;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.cta-banner::before {
  content: 'SCENTIA';
  position: absolute;
  font-family: var(--serif);
  font-size: 22vw;
  font-weight: 300;
  color: rgba(255,255,255,.025);
  top: 50%; left: 50%;
  transform: translate(-50%,-50%);
  white-space: nowrap;
  pointer-events: none;
}

.cta-banner h2 {
  font-family: var(--serif);
  font-size: clamp(2.4rem, 4vw, 4rem);
  font-weight: 300;
  color: var(--cream);
  line-height: 1.15;
  margin-bottom: 20px;
  position: relative;
}

.cta-banner p {
  font-size: .95rem;
  color: rgba(251,248,243,.5);
  max-width: 480px;
  margin: 0 auto 44px;
  line-height: 1.75;
  position: relative;
}

.cta-banner .btn-group {
  justify-content: center;
  position: relative;
}

.btn-gold {
  background: var(--gold);
  color: var(--dark);
  box-shadow: 0 8px 32px rgba(201,168,76,.35);
}

.btn-gold:hover {
  background: var(--gold-lt);
  box-shadow: 0 12px 40px rgba(201,168,76,.5);
}

/* ── Footer ─────────────────────────────────────────────────────────── */
footer {
  background: var(--dark2);
  padding: 72px 48px 40px;
  border-top: 1px solid rgba(255,255,255,.04);
}

.footer-inner {
  max-width: 1280px;
  margin: 0 auto;
}

.footer-top {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 48px;
  padding-bottom: 56px;
  border-bottom: 1px solid rgba(255,255,255,.06);
  margin-bottom: 36px;
}

.footer-brand .nav-logo-text { color: var(--cream); }

.footer-brand p {
  font-size: .85rem;
  line-height: 1.75;
  color: rgba(251,248,243,.35);
  margin-top: 16px;
  max-width: 260px;
}

.footer-col h5 {
  font-size: .7rem;
  font-weight: 500;
  letter-spacing: .15em;
  text-transform: uppercase;
  color: rgba(251,248,243,.35);
  margin-bottom: 20px;
}

.footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }

.footer-col ul a {
  text-decoration: none;
  font-size: .88rem;
  color: rgba(251,248,243,.55);
  transition: color .2s;
}

.footer-col ul a:hover { color: var(--cream); }

.footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
}

.footer-bottom p {
  font-size: .77rem;
  color: rgba(251,248,243,.25);
}

.footer-socials { display: flex; gap: 16px; }

.social-btn {
  width: 38px; height: 38px;
  border-radius: 50%;
  border: 1px solid rgba(255,255,255,.1);
  display: flex; align-items: center; justify-content: center;
  text-decoration: none;
  font-size: .85rem;
  color: rgba(251,248,243,.5);
  transition: border-color .2s, color .2s, background .2s;
}

.social-btn:hover {
  border-color: var(--gold);
  color: var(--gold);
  background: rgba(201,168,76,.08);
}

/* ── Reveal animations ──────────────────────────────────────────────── */
[data-reveal] {
  opacity: 0;
  transform: translateY(28px);
  transition: opacity .7s ease, transform .7s ease;
}

[data-reveal].visible {
  opacity: 1;
  transform: translateY(0);
}

/* ── Responsive ─────────────────────────────────────────────────────── */
@media (max-width: 1024px) {
  .features-grid { grid-template-columns: repeat(2, 1fr); }
  .scents-grid   { grid-template-columns: repeat(2, 1fr); }
  .footer-top    { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 768px) {
  nav { padding: 18px 24px; }
  nav.scrolled { padding: 12px 24px; }
  .nav-links { display: none; }

  .hero {
    grid-template-columns: 1fr;
    padding: 100px 24px 60px;
    text-align: center;
  }
  .hero-copy { max-width: 100%; }
  .eyebrow    { justify-content: center; }
  .hero-desc  { max-width: 100%; }
  .btn-group  { justify-content: center; }
  .hero-stat-row { justify-content: center; }
  .hero-visual { display: none; }

  .features, .products, .scents { padding: 80px 24px; }
  .testimonials { padding: 80px 24px; }
  .cta-banner   { padding: 80px 24px; }
  footer        { padding: 56px 24px 32px; }

  .features-grid  { grid-template-columns: 1fr; }
  .products-grid  { grid-template-columns: 1fr; }
